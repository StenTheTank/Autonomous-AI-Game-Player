timestamp=2026-11-15T04:37:54.744Z level=INFO run=422486bc message=evaluated permission=bash pattern="python3 -c '\nimport urllib.request, json\n\nstatus = json.loads(urllib.request.urlopen(\"http://127.0.0.1:18765/status\").read())\nlegal = json.loads(urllib.request.urlopen(\"http://127.0.0.1:18765/legal\").read())\nstate = status[\"state\"]\nsummary = status[\"board_summary\"]\n\nDENSE_CITIES = {\"birmingham\", \"wolverhampton\", \"walsall\", \"dudley\", \"coventry\", \"stoke\", \"derby\"}\nMERCHANT_PORTS = {\"shrewsbury\", \"gloucester\", \"oxford\"}\n\ndef score_action(action, state, summary):\n    atype = action.get(\"action_type\")\n    score = 0.0\n    era = state.get(\"era\", \"canal\")\n    turn = state.get(\"turn\", 1)\n    money = state.get(\"money\", 0)\n    iron_cubes = state.get(\"iron_cubes\", 0)\n    coal_cubes = state.get(\"coal_cubes\", 0)\n    empty_iron = max(0, 14 - iron_cubes)\n    empty_coal = max(0, 14 - coal_cubes)\n\n    if atype == \"sell\":\n        score = 300.0\n        sales = action.get(\"sales\") or []\n        score += 50.0 * len(sales)\n        if era == \"canal\" and turn >= 8:\n            score += 100.0\n        elif era == \"rail\" and turn >= 8:\n            score += 150.0\n\n    elif atype == \"network\":\n        is_double = action.get(\"is_double_rail\", False)\n        if era == \"rail\":\n            if is_double:\n                score = 280.0\n                if summary.get(\"player_beer_barrels\", 0) > 0:\n                    score += 40.0\n                for lid in action.get(\"link_ids\", []):\n                    for city in lid.split(\"-\"):\n                        if city in DENSE_CITIES:\n                            score += 15.0\n            else:\n                score = 110.0\n                lid = action.get(\"link_id\", \"\")\n                for city in lid.split(\"-\"):\n                    if city in DENSE_CITIES:\n                        score += 10.0\n        else: # canal\n            score = 60.0\n            lid = action.get(\"link_id\", \"\")\n            cities = lid.split(\"-\")\n            has_merchant = any(c in MERCHANT_PORTS for c in cities)\n            has_dense = any(c in DENSE_CITIES for c in cities)\n            if has_merchant:\n                score += 80.0\n            if has_dense:\n                score += 25.0\n            p_links = summary.get(\"player_link_count\", 0)\n            if p_links >= 5:\n                score -= 15.0 * (p_links - 4)\n\n    elif atype == \"build\":\n        ind = action.get(\"industry\")\n        lvl = action.get(\"level\", 1)\n        city = action.get(\"city\", \"\")\n\n        if ind == \"iron\":\n            if empty_iron >= 4:\n                score = 260.0\n            elif empty_iron >= 2:\n                score = 180.0\n            else:\n                score = 110.0\n            if lvl >= 2:\n                score += 30.0\n        elif ind == \"coal\":\n            score = 130.0\n            if lvl >= 2:\n                score += 25.0\n            if era == \"rail\" and coal_cubes == 0:\n                score += 40.0\n        elif ind == \"brewery\":\n            if era == \"canal\":\n                if summary.get(\"player_unflipped_count\", 0) > 0:\n                    score = 200.0\n                else:\n                    score = 95.0\n            else:\n                if summary.get(\"player_beer_barrels\", 0) == 0:\n                    score = 210.0\n                elif summary.get(\"player_beer_barrels\", 0) >= 2:\n                    score = 70.0\n                else:\n                    score = 140.0\n        elif ind in (\"cotton\", \"goods\", \"pottery\"):\n            if ind == \"pottery\":\n                score = 160.0\n            elif ind == \"cotton\":\n                score = 140.0 if lvl >= 2 else 90.0\n            elif ind == \"goods\":\n                score = 130.0 if lvl >= 2 else 70.0\n            if era == \"canal\" and lvl >= 2:\n                score += 35.0\n            if summary.get(\"player_beer_barrels\", 0) > 0 or summary.get(\"merchant_beer_barrels\", 0) > 0:\n                score += 25.0\n\n    elif atype == \"develop\":\n        inds = action.get(\"industries\", [])\n        score = 80.0\n        if \"goods\" in inds:\n            score += 35.0\n        if \"cotton\" in inds:\n            score += 25.0\n        if \"iron\" in inds:\n            score += 20.0\n        if era == \"canal\":\n            if turn <= 3:\n                score += 40.0\n            elif turn <= 6:\n                score += 15.0\n            else:\n                score -= 50.0\n\n    elif atype == \"loan\":\n        if era == \"canal\":\n            if money <= 6 and turn <= 6:\n                score = 175.0\n            elif money <= 10 and turn <= 5:\n                score = 90.0\n            elif money >= 16:\n                score = -150.0\n            elif turn >= 8:\n                score = -400.0\n        else:\n            if money <= 12 and turn <= 4:\n                score = 170.0\n            elif money >= 18:\n                score = -150.0\n            elif turn >= 7:\n                score = -600.0\n\n    elif atype == \"scout\":\n        score = -50.0\n    elif atype == \"pass\":\n        score = -1000.0\n\n    return score\n\nranked = sorted([(score_action(a, state, summary), a[\"action_id\"], a[\"action_type\"], a.get(\"description\")) for a in legal[\"actions\"]], reverse=True)\nfor s, aid, at, desc in ranked[:10]:\n    print(f\"{s:6.1f} | [{aid:2d}] {at:8s} | {desc}\")\n'" action.permission=* action.action=allow action.pattern=*
