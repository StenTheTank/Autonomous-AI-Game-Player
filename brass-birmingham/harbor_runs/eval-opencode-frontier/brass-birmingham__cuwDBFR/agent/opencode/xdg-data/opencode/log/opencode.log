timestamp=2026-11-15T04:40:16.652Z level=INFO run=468603e2 message=evaluated permission=bash pattern="python3 -c \"\nimport urllib.request, json, re\nfrom play_brass import parse_action_notes\n\ndef is_connected_to_merchant(city, links):\n    merchants = {'shrewsbury', 'gloucester', 'oxford', 'nottingham', 'warrington'}\n    if city in merchants:\n        return True\n    visited = set([city])\n    queue = [city]\n    adj = {}\n    for lid in links.keys():\n        parts = lid.split('-')\n        for i in range(len(parts)):\n            for j in range(i+1, len(parts)):\n                adj.setdefault(parts[i], set()).add(parts[j])\n                adj.setdefault(parts[j], set()).add(parts[i])\n    while queue:\n        curr = queue.pop(0)\n        if curr in merchants:\n            return True\n        for nxt in adj.get(curr, []):\n            if nxt not in visited:\n                visited.add(nxt)\n                queue.append(nxt)\n    return False\n\ndef score_action_v2(action, state, summary, notes_dict):\n    aid = action['action_id']\n    atype = action.get('action_type') or action.get('type', '')\n    cost = action.get('cost', 0)\n    note = notes_dict.get(aid, {})\n    era = state.get('era', 'canal')\n    turn = state.get('turn', 1)\n    money = state.get('money', 0)\n    income_space = state.get('income_space', 10)\n    links = state.get('links', {})\n    \n    is_late_era = (era == 'canal' and turn >= 8) or (era == 'rail' and (turn >= 8 or turn >= 18))\n    is_very_late_era = (era == 'canal' and turn >= 9) or (era == 'rail' and (turn >= 9 or turn >= 19))\n    is_early_era = (turn <= 4)\n    \n    score = 0.0\n    score -= cost * 0.02\n    \n    if atype == 'sell':\n        score += 170.0\n        sales = action.get('sales', [])\n        if sales and isinstance(sales, list):\n            score += len(sales) * 35.0\n            for s in sales:\n                if isinstance(s, dict):\n                    score += s.get('vp', 0) * 8.0\n                    score += s.get('income', 0) * 4.0\n        else:\n            score += note.get('tile_vp', 0) * 8.0\n            score += note.get('tile_inc', 0) * 4.0\n            score += note.get('link_dots', 0) * 6.0\n        if is_late_era:\n            score += 130.0\n\n    elif atype == 'network':\n        is_double = action.get('is_double_rail', False)\n        link_vp = note.get('link_vp', 0)\n        connects_merch = note.get('connects_merchant', False)\n        if era == 'rail':\n            if is_double:\n                score += 150.0 + (link_vp * 8.0)\n                if connects_merch:\n                    score += 20.0\n            else:\n                score += 75.0 + (link_vp * 8.0)\n                if connects_merch:\n                    score += 15.0\n        else:\n            score += 50.0 + (link_vp * 7.0)\n            if connects_merch:\n                score += 35.0\n            if turn == 1 and 'birmingham-oxford' in action.get('link_id', ''):\n                score += 40.0\n            if is_late_era and link_vp >= 3:\n                score += 30.0\n\n    elif atype == 'build':\n        ind = action.get('industry', '')\n        level = action.get('level', 1)\n        city = action.get('city', '')\n        unlinked = note.get('unlinked', False)\n        tile_vp = note.get('tile_vp', 0)\n        tile_inc = note.get('tile_inc', 0)\n        \n        if ind == 'brewery':\n            beer_count = summary.get('player_beer_barrels', 0)\n            if era == 'canal':\n                if beer_count == 0:\n                    score += 100.0 + tile_vp * 4.0\n                else:\n                    score += 65.0 + tile_vp * 3.0\n                if level >= 2:\n                    score += 40.0\n            else:\n                score += (140.0 if beer_count == 0 else 80.0) + tile_vp * 4.0\n\n        elif ind == 'coal':\n            mine_cubes = summary.get('player_remaining_mine_cubes', 0)\n            conn_merch = is_connected_to_merchant(city, links)\n            coal_cubes = state.get('coal_cubes', 14)\n            if conn_merch and coal_cubes < 14:\n                score += 30.0  # auto-sells to coal market!\n            if mine_cubes >= 2:\n                score -= 60.0  # already have excess unflipped coal on board!\n            score += 60.0 + tile_vp * 5.0 + tile_inc * 4.0\n            if era == 'canal' and level >= 2:\n                score += 35.0\n\n        elif ind == 'iron':\n            iron_cubes = state.get('iron_cubes', 8)\n            if iron_cubes < 14:\n                score += 35.0  # sells iron to market immediately\n            score += 75.0 + tile_vp * 5.0 + tile_inc * 4.0\n            if era == 'canal' and level >= 2:\n                score += 40.0\n\n        elif ind in ('cotton', 'goods', 'pottery'):\n            if unlinked:\n                if is_late_era:\n                    score -= 120.0\n                elif turn <= 2:\n                    score += 35.0\n                else:\n                    score += 25.0\n            else:\n                if level >= 2:\n                    score += 110.0 + tile_vp * 6.0 + tile_inc * 3.0\n                elif ind == 'goods':\n                    score += 40.0 + tile_vp * 4.0\n                elif ind == 'pottery':\n                    score += 105.0 + tile_vp * 6.0 + tile_inc * 3.0\n                else:\n                    score += 80.0 + tile_vp * 5.0 + tile_inc * 3.0\n\n        if era == 'canal':\n            if level >= 2 and ind not in ('coal', 'iron', 'brewery'):\n                score += 40.0\n            elif is_late_era:\n                score -= 70.0\n\n    elif atype == 'develop':\n        inds = action.get('industries', [])\n        if era == 'canal':\n            if turn <= 5:\n                score += 90.0\n                if 'goods' in inds:\n                    score += 20.0\n                if 'cotton' in inds:\n                    score += 10.0\n                if 'brewery' in inds:\n                    score += 12.0\n            elif turn <= 7:\n                score += 45.0\n            else:\n                score -= 60.0\n        else:\n            score += 25.0 if turn <= 14 else -80.0\n\n    elif atype == 'loan':\n        if note.get('loan_warn', False) or is_very_late_era:\n            score -= 250.0\n        elif money >= 18:\n            score -= 100.0\n        elif money <= 7:\n            if (era == 'canal' and turn <= 6) or (era == 'rail' and (turn <= 6 or turn <= 16)):\n                score += 95.0\n            else:\n                score += 40.0\n        elif money <= 13:\n            score += 45.0\n        else:\n            score -= 20.0\n        if income_space < 10:\n            score -= 100.0\n\n    elif atype == 'scout':\n        score -= 60.0\n\n    elif atype == 'pass':\n        score -= 1000.0\n\n    rem_money = money - cost\n    if rem_money < 2 and income_space <= 10 and turn > 1 and atype not in ('sell', 'loan'):\n        score -= 15.0\n\n    return score\n\nstatus = json.loads(urllib.request.urlopen('http://127.0.0.1:18765/status').read().decode())\nlegal = json.loads(urllib.request.urlopen('http://127.0.0.1:18765/legal').read().decode())\nnotes = parse_action_notes(legal['formatted'])\n\nscored = []\nfor a in legal['actions']:\n    s = score_action_v2(a, status['state'], status['board_summary'], notes)\n    scored.append((s, a['action_id'], a['description']))\n\nscored.sort(reverse=True)\nfor s, aid, desc in scored[:10]:\n    print(f'Score: {s:6.1f} | ID: {aid:2d} | {desc}')\n\"" action.permission=* action.action=allow action.pattern=*
