timestamp=2026-11-15T04:45:37.631Z level=INFO run=468603e2 message=evaluated permission=bash pattern="python3 -c \"\nimport urllib.request, json\nfrom play_brass import parse_action_notes, is_connected_to_merchant, get_current_level\n\ndef test_score(turn):\n    status = json.loads(urllib.request.urlopen('http://127.0.0.1:18765/status').read().decode())\n    legal = json.loads(urllib.request.urlopen('http://127.0.0.1:18765/legal').read().decode())\n    notes = parse_action_notes(legal['formatted'])\n    state = status['state']\n    summary = status['board_summary']\n    links = state['links']\n    \n    scored = []\n    for a in legal['actions']:\n        aid = a['action_id']\n        atype = a['action_type']\n        cost = a.get('cost', 0)\n        note = notes.get(aid, {})\n        era = state['era']\n        \n        score = -cost * 0.02\n        if atype == 'network':\n            link_vp = note.get('link_vp', 0)\n            connects_merch = note.get('connects_merchant', False)\n            if era == 'canal':\n                multiplier = 14.0 if turn >= 7 else 7.0\n                score += 50.0 + (link_vp * multiplier)\n                if connects_merch:\n                    score += 35.0\n        elif atype == 'build':\n            ind = a.get('industry', '')\n            city = a.get('city', '')\n            level = a.get('level', 1)\n            tile_vp = note.get('tile_vp', 0)\n            tile_inc = note.get('tile_inc', 0)\n            conn_merch = is_connected_to_merchant(city, links)\n            auto_flips = note.get('auto_flips', False)\n            \n            if ind == 'coal':\n                if not conn_merch and not auto_flips and turn >= 7:\n                    score -= 70.0\n                score += 60.0 + tile_vp * 5.0 + tile_inc * 4.0\n                if era == 'canal' and level >= 2:\n                    score += 35.0\n            elif ind == 'brewery':\n                score += 90.0 + tile_vp * 4.0\n                \n        scored.append((score, aid, a['description']))\n    scored.sort(reverse=True)\n    for s, aid, desc in scored[:5]:\n        print(f'{s:6.1f} | {aid:2d} | {desc}')\n\ntest_score(7)\n\"" action.permission=* action.action=allow action.pattern=*
