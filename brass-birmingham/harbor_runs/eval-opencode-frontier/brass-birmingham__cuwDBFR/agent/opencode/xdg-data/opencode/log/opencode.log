timestamp=2026-11-15T04:37:52.842Z level=INFO run=468603e2 message=evaluated permission=bash pattern="python3 -c \"\nimport urllib.request, json, re\n\ndef parse_action_notes(formatted_text):\n    notes_by_id = {}\n    for line in formatted_text.splitlines():\n        m = re.match(r'\\s*\\[\\s*(\\d+)\\]\\s*(.*)', line)\n        if not m:\n            continue\n        aid = int(m.group(1))\n        rest = m.group(2)\n        notes = re.findall(r'\\[([^\\]]+)\\]', rest)\n        parsed = {\n            'raw_notes': notes,\n            'tile_vp': 0,\n            'tile_inc': 0,\n            'link_dots': 0,\n            'link_vp': 0,\n            'unlinked': False,\n            'connects_merchant': False,\n            'dev_tiles': 0,\n            'loan_warn': False\n        }\n        for note in notes:\n            mvp = re.search(r'(?:tile=|\\+)?(\\d+)VP', note)\n            if mvp:\n                parsed['tile_vp'] = int(mvp.group(1))\n            minc = re.search(r'\\+(\\d+)inc', note)\n            if minc:\n                parsed['tile_inc'] = int(minc.group(1))\n            mdot = re.search(r'(\\d+)•', note)\n            if mdot:\n                parsed['link_dots'] = int(mdot.group(1))\n            lvp = re.search(r'currently \\+(\\d+) link VP', note)\n            if lvp:\n                parsed['link_vp'] = int(lvp.group(1))\n            if 'not yet linked to matching merchant' in note:\n                parsed['unlinked'] = True\n            if 'connects merchant port' in note:\n                parsed['connects_merchant'] = True\n            mdev = re.search(r'unlocks higher tech \\((\\d+) tiles\\)', note)\n            if mdev:\n                parsed['dev_tiles'] = int(mdev.group(1))\n            if 'WARN' in note:\n                parsed['loan_warn'] = True\n        notes_by_id[aid] = parsed\n    return notes_by_id\n\ndef score_action(action, state, summary, notes_dict):\n    aid = action['action_id']\n    atype = action['action_type']\n    cost = action.get('cost', 0)\n    note = notes_dict.get(aid, {})\n    era = state.get('era', 'canal')\n    turn = state.get('turn', 1)\n    money = state.get('money', 0)\n    income_space = state.get('income_space', 10)\n    \n    score = 0.0\n    \n    if atype == 'sell':\n        score += 150.0\n        score += note.get('tile_vp', 0) * 8.0\n        score += note.get('tile_inc', 0) * 4.0\n        score += note.get('link_dots', 0) * 6.0\n        if era == 'canal' and turn >= 8:\n            score += 100.0\n        if era == 'rail' and turn >= 18:\n            score += 100.0\n\n    elif atype == 'network':\n        is_double = action.get('is_double_rail', False)\n        link_vp = note.get('link_vp', 0)\n        connects_merch = note.get('connects_merchant', False)\n        \n        if era == 'rail':\n            if is_double:\n                score += 140.0 + (link_vp * 8.0)\n                if connects_merch:\n                    score += 20.0\n            else:\n                score += 70.0 + (link_vp * 8.0)\n                if connects_merch:\n                    score += 15.0\n        else: # canal\n            score += 45.0 + (link_vp * 7.0)\n            if connects_merch:\n                score += 30.0\n            # Special canal turn 1 Oxford connection bonus:\n            link_id = action.get('link_id', '')\n            if turn == 1 and 'birmingham-oxford' in link_id:\n                score += 35.0\n            if turn >= 8 and link_vp >= 3:\n                score += 25.0\n\n    elif atype == 'build':\n        ind = action.get('industry', '')\n        level = action.get('level', 1)\n        unlinked = note.get('unlinked', False)\n        tile_vp = note.get('tile_vp', 0)\n        tile_inc = note.get('tile_inc', 0)\n        \n        if ind == 'brewery':\n            if era == 'canal':\n                if level >= 2:\n                    score += 95.0 + tile_vp * 4.0\n                else:\n                    score += 65.0 + tile_vp * 3.0\n            else: # rail\n                barrels = summary.get('player_beer_barrels', 0)\n                score += (130.0 if barrels == 0 else 75.0) + tile_vp * 4.0\n        elif ind in ('coal', 'iron'):\n            score += 85.0 + tile_vp * 5.0 + tile_inc * 4.0\n        elif ind in ('cotton', 'goods', 'pottery'):\n            if unlinked:\n                if (era == 'canal' and turn >= 8) or (era == 'rail' and turn >= 18):\n                    score -= 100.0\n                elif turn == 1:\n                    score += 35.0\n                else:\n                    score += 25.0\n            else:\n                if level >= 2:\n                    score += 100.0 + tile_vp * 6.0 + tile_inc * 3.0\n                elif ind == 'goods':\n                    score += 35.0\n                else:\n                    score += 70.0 + tile_vp * 5.0 + tile_inc * 3.0\n        \n        if era == 'canal':\n            if level >= 2:\n                score += 35.0\n            elif turn >= 8:\n                score -= 60.0\n\n    elif atype == 'develop':\n        inds = action.get('industries', [])\n        if era == 'canal':\n            if turn <= 5:\n                score += 65.0\n                if 'goods' in inds:\n                    score += 15.0\n                if 'cotton' in inds or 'brewery' in inds:\n                    score += 10.0\n            elif turn <= 7:\n                score += 40.0\n            else:\n                score -= 60.0\n        else: # rail\n            score += 25.0 if turn <= 14 else -80.0\n\n    elif atype == 'loan':\n        if note.get('loan_warn', False) or (era == 'canal' and turn >= 9) or (era == 'rail' and turn >= 18):\n            score -= 250.0\n        elif money >= 18:\n            score -= 100.0\n        elif money <= 7:\n            score += 90.0 if ((era == 'canal' and turn <= 6) or (era == 'rail' and turn <= 15)) else 40.0\n        elif money <= 13:\n            score += 45.0\n        else:\n            score -= 20.0\n        if income_space < 10:\n            score -= 80.0\n\n    elif atype == 'scout':\n        score -= 60.0\n\n    elif atype == 'pass':\n        score -= 1000.0\n\n    # Budget check:\n    rem_money = money - cost\n    if rem_money < 2 and income_space <= 10 and turn > 1 and atype not in ('sell', 'loan'):\n        score -= 15.0\n\n    return score\n\nstatus = json.loads(urllib.request.urlopen('http://127.0.0.1:18765/status').read().decode())\nlegal = json.loads(urllib.request.urlopen('http://127.0.0.1:18765/legal').read().decode())\nnotes = parse_action_notes(legal['formatted'])\n\nscored = []\nfor a in legal['actions']:\n    s = score_action(a, status['state'], status['board_summary'], notes)\n    scored.append((s, a['action_id'], a['description']))\n\nscored.sort(reverse=True)\nprint('Top 10 actions:')\nfor s, aid, desc in scored[:10]:\n    print(f'Score: {s:6.1f} | ID: {aid:2d} | {desc}')\n\"" action.permission=* action.action=allow action.pattern=*
